{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "cost": {
            "input": 10,
            "output": 50,
            "cache_read": 1,
            "cache_write": 12.5,
            "context_over_200k": {
              "input": 20,
              "output": 75,
              "cache_read": 2,
              "cache_write": 25
            }
          },
          "options": {
            "reasoningEffort": "high"
          }
        }
      },
      "options": {
        "reasoningEffort": "high"
      }
    },
    "inference.nvidia.com": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "inference.nvidia.com",
      "options": {
        "baseURL": "https://inference-api.nvidia.com/v1",
        "apiKey": "{env:NVINFERENCE_API_KEY}"
      },
      "models": {
        "aws/anthropic/bedrock-claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "limit": {
            "context": 200000,
            "output": 65536
          }
        },
        "nvidia/nvidia/Nemotron-3-Nano-30B-A3B": {
          "name": "nemotron 3 nano",
          "limit": {
            "context": 255000,
            "output": 65536
          }
        },
        "nvidia/nvidia/nemotron-nano-12b-v2-vl": {
          "name": "nemotron multimodal",
          "limit": {
            "context": 128000,
            "output": 65536
          }
        }
      }
    },
    "inference.nvidia.com-openai": {
      "npm": "@ai-sdk/openai",
      "name": "inference.nvidia.com-openai",
      "options": {
        "baseURL": "https://inference-api.nvidia.com/v1",
        "apiKey": "{env:NVINFERENCE_API_KEY}"
      },
      "models": {
        "openai/openai/gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 400000,
            "output": 65536
          }
        }
      }
    },
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "1111"
      },
      "models": {
        "mlx-community/gemma-4-26b-a4b-it-4bit": {
            "name": "Gemma 4 26B 4-bit"
        },
        "unsloth/Qwen3.6-35B-A3B-UD-MLX-4bit ": {
            "name": "Qwen 3.6 35B 4-bit"
        },
        "mlx-community/gemma-4-31b-it-4bit": {
            "name": "Gemma 4 31B 4-bit"
        }
      }
    }

  },
  "mode": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "investigate": {
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "variant": "high",
      "tools": {
        "write": false,
        "edit": false,
        "bash": true
      }
    }
  },
  "agent": {
    "compaction": {
      "model": "openai/gpt-6-luna",
    }
  }
}

#!/bin/sh
set -eu

case "${1:-}" in
    hdmi)
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.priority.1 \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.mirror.none \
            output.DP-3.disable
        ;;
    dp)
        kscreen-doctor \
            output.DP-3.mirror.none \
            output.DP-3.enable \
            output.DP-3.priority.1 \
            output.DP-3.position.0,0 \
            output.HDMI-A-1.disable
        ;;
    mirror)
        kscreen-doctor \
            output.HDMI-A-1.enable \
            output.HDMI-A-1.priority.1 \
            output.HDMI-A-1.position.0,0 \
            output.DP-3.enable \
            output.DP-3.priority.2 \
            output.DP-3.position.0,0 \
            output.DP-3.mirror.HDMI-A-1
        ;;
    *)
        exit 2
        ;;
esac
